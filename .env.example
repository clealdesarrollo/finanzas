# ==========================================================
# FINANCONTROL - VARIABLES DE ENTORNO EJEMPLO (.env.example)
# ==========================================================

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Puerto en el que escucha el servidor Express (por defecto 3000)
PORT=3000

# URL canónica de la aplicación (usada para CORS y redirecciones)
APP_URL=https://mi-dominio-financontrol.onrender.com

# Clave secreta para la firma de tokens JWT (debe ser una cadena aleatoria y segura de al menos 32 caracteres)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_debe_cambiarse_en_produccion

# Cadena de conexión a base de datos PostgreSQL en producción (Render / Railway / Supabase):
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>?sslmode=require
DATABASE_URL=postgresql://finanuser:finansecurepassword2026@localhost:5432/financontrol

# Ruta de base de datos SQLite (usada solo en desarrollo local sin PostgreSQL o tests):
# Si DATABASE_URL está vacía, el sistema usa SQLite automáticamente en ./data/financontrol.sqlite
SQLITE_PATH=./data/financontrol.sqlite
